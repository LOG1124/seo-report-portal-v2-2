# 本机 OSS 发布配置；AccessKey 只保存在与本文件同目录的 ossutilconfig。
# 发布器是跨平台 Python 脚本：Windows 请直接运行 publish_oss_report.py。
OSSUTIL_BIN=ossutil
OSSUTIL_CONFIG_FILE=ossutilconfig
OSS_BUCKET=jzyseo-reports
OSS_PUBLIC_BASE_URL=https://reports.jzyseo.com
OSS_REPORT_PREFIX=reports
# macOS 示例：/Volumes/共享盘/seo-report-portal
# Windows 示例：Z:\seo-report-portal 或 \\192.168.110.26\共享盘\seo-report-portal
# 必填：先确认该 SMB 路径在本机可访问，再填写。
OSS_ARCHIVE_ROOT=
# 仅供复制到 publish_oss_report.py 的 --source-archive-root 参数；发布器不会隐式读取它，
# 采集器和生成器也不会读取它，二者必须始终显式传入 --archive-root。
# macOS 示例：/Volumes/共享盘/seo-report-source-archive
# Windows 示例：Z:\seo-report-source-archive 或 \\server\共享盘\seo-report-source-archive
GOOGLE_SOURCE_ARCHIVE_ROOT=
